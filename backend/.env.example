MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
GEMINI_API_KEY=<your_gemini_api_key>
JWT_SECRET=<long-random-string>
PORT=5000
# Email verification — prefer Brevo REST API (works on any host, incl. Render)
# 1) Get a key: https://app.brevo.com -> SMTP & API -> API Keys (xkeysib-...)
# 2) Verify a sender: https://app.brevo.com -> Senders & IP
# 3) Set the verified sender as EMAIL_FROM below
BREVO_API_KEY=<your_brevo_api_key>
EMAIL_FROM=Expense Tracker <your_gmail_address>
# Where verification links point (the frontend URL)
CLIENT_URL=http://localhost:3000

# Fallback SMTP (Gmail App Password) — used only when BREVO_API_KEY is unset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<your_gmail_address>
SMTP_PASS=<your_gmail_app_password>